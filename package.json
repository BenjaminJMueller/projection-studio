{
  "name": "projection-studio",
  "productName": "Projection Studio",
  "version": "1.0.0",
  "description": "Projektoren gegen ein 3D-Modell kalibrieren, überblenden, feinkorrigieren und abspielen – mit TouchDesigner-Anbindung",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/check-syntax.mjs && node --test test/*.test.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "lint": "node scripts/check-syntax.mjs",
    "test:e2e": "node test/e2e/smoke.mjs test-output",
    "dist": "electron-builder --publish never"
  },
  "author": "Benny",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "playwright": "^1.56.1"
  },
  "build": {
    "appId": "de.pixelcampus.projection-studio",
    "productName": "Projection Studio",
    "files": [
      "src/**/*",
      "td/**/*",
      "examples/**/*",
      "node_modules/three/build/three.module.js",
      "node_modules/three/LICENSE",
      "package.json"
    ],
    "asarUnpack": [
      "examples/**/*",
      "td/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "identity": "-"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}